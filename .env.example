# ---- Office 3D: configuração de exemplo (copie para .env) ----
PORT=8787
# true = contas e conectores fictícios (dados de demonstração criados na primeira execução)
DEMO_MODE=true

# Banco: sqlite (caminho local reproduzível) ou mariadb (produção)
DB_DRIVER=sqlite
SQLITE_PATH=data/office3d.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=office3d
# DB_PASSWORD=
# DB_NAME=office3d

SESSION_TTL_HOURS=12
# true atrás de HTTPS
COOKIE_SECURE=false
DATA_DIR=data

# Conectores: demo | (real)
CHAT_PROVIDER=demo            # demo | workscape
TRANSFER_PROVIDER=demo        # demo | workscape
REMOTE_PROVIDER=demo          # demo | anydesk
PRINT_PROVIDER=demo           # demo | ipp | none
# manual = mostra o endereço AnyDesk; uri = também o link anydesk: (só depois de validar no ambiente gerenciado)
ANYDESK_LAUNCH=manual
WORKSCAPE_BASE_URL=
WORKSCAPE_TOKEN=

# Hosts https autorizados (separados por vírgula)
DASHBOARD_ALLOWED_HOSTS=
CAD_ALLOWED_HOSTS=

PRINT_MAX_MB=10
PRINT_RETENTION_MINUTES=30
UPLOAD_MAX_MB=8

# Presença ao vivo e avatares
CALL_PROVIDER=demo            # demo | workscape — fonte do ciclo de atendimento e do indicador de fala
PRESENCE_GRACE_MS=15000       # tolerância após fechar a última aba antes de ficar offline
TYPING_TTL_MS=6000            # validade de um sinal de digitação sem renovação
SPEAKING_TTL_MS=5000          # validade do indicador de fala sem renovação
CALL_MAX_MS=14400000          # salvaguarda: encerra chamada esquecida aberta (4 h)
LIVE_HEARTBEAT_MS=20000       # batimento do fluxo SSE
