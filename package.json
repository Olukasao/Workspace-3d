{
  "name": "office-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Office 3D — planta corporativa interativa (editor + modo operacional)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx server/db/cli.ts migrate",
    "db:seed": "tsx server/db/cli.ts seed",
    "db:reset": "tsx server/db/cli.ts reset",
    "assets:fetch": "tsx tools/assets/fetch.ts",
    "assets:process": "tsx tools/assets/process.ts",
    "assets:validate": "tsx tools/assets/validate.ts",
    "assets:thumbs": "node tools/assets/thumbs.mjs",
    "assets:all": "npm run assets:fetch && npm run assets:process && npm run assets:thumbs && npm run assets:validate && npm run assets:report",
    "e2e": "node tools/e2e/run.mjs",
    "perf": "node tools/e2e/perf.mjs",
    "assets:report": "tsx tools/assets/report.ts",
    "shot": "node tools/e2e/shot.mjs",
    "e2e:draw": "node tools/e2e/draw.mjs",
    "e2e:avatars": "node tools/e2e/avatars.mjs",
    "perf:avatars": "node tools/e2e/perf-avatars.mjs",
    "avatars:build": "node tools/avatars/build.mjs",
    "avatars:process": "tsx tools/avatars/process.ts",
    "avatars:sheet": "node tools/avatars/sheet.mjs",
    "avatars-ara:build": "node tools/avatars-ara/build.mjs",
    "avatars-ara:process": "tsx tools/avatars-ara/process.ts",
    "avatars-ara:thumbs": "node tools/avatars-ara/thumbs.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.0.10",
    "@gltf-transform/extensions": "^4.0.10",
    "@gltf-transform/functions": "^4.0.10",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "meshoptimizer": "^0.22.0",
    "mysql2": "^3.11.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "three": "^0.169.0",
    "tsx": "^4.19.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22.5"
  }
}
